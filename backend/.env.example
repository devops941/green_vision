# =====================================================================
# GreenVision Backend Configuration
# Target Scope: Madurai District, Tamil Nadu, India
# =====================================================================

# Server Settings
APP_NAME="GreenVision - Satellite Urban Vegetation Intelligence"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./greenvision.db

# Storage Directories (Relative or Absolute Paths)
DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
NDVI_OUTPUT_DIR=./data/ndvi_outputs
REPORTS_DIR=./data/reports
BOUNDARIES_DIR=./data/boundaries

# Satellite Upload Limits
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=["tif", "tiff", "jp2"]

# Geospatial Parameters (Madurai District, Tamil Nadu)
# Bounding Box: [min_lon, min_lat, max_lon, max_lat]
MADURAI_BBOX_MIN_LON=77.68
MADURAI_BBOX_MIN_LAT=9.53
MADURAI_BBOX_MAX_LON=78.52
MADURAI_BBOX_MAX_LAT=10.35
DEFAULT_CRS=EPSG:32644

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]
